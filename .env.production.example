# Todas las imágenes deben usar digest sha256; nunca latest ni una etiqueta mutable.
APP_IMAGE=ghcr.io/dadd86/iocode-solutions@sha256:REPLACE_WITH_64_HEX_DIGEST
NGINX_IMAGE=nginxinc/nginx-unprivileged@sha256:REPLACE_WITH_64_HEX_DIGEST
PUBLIC_DEPLOY_ENV=production
PUBLIC_SITE_URL=https://iocode-solutions.com
# La identidad y el contenido legal (§5 DDG, RGPD) se versionan en
# src/data/legal-profile.ts y src/data/legal.ts; no dependen de variables de entorno.
TLS_FULLCHAIN_PATH=/etc/letsencrypt/live/iocode-solutions.com/fullchain.pem
TLS_PRIVKEY_PATH=/etc/letsencrypt/live/iocode-solutions.com/privkey.pem
RELEASE_ROOT=/opt/iocode/releases
RELEASE_ID=REPLACE_WITH_GIT_SHA
ASTRO_TELEMETRY_DISABLED=1
