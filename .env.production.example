# Todas las imágenes deben usar digest sha256; nunca latest ni una etiqueta mutable.
APP_IMAGE=ghcr.io/dadd86/iocode-solutions@sha256:REPLACE_WITH_64_HEX_DIGEST
NGINX_IMAGE=nginxinc/nginx-unprivileged@sha256:REPLACE_WITH_64_HEX_DIGEST
PUBLIC_DEPLOY_ENV=production
PUBLIC_SITE_URL=https://iocode-solutions.com
PUBLIC_LEGAL_APPROVED=false
PUBLIC_PRIVACY_APPROVED=false
PUBLIC_LEGAL_NAME=REPLACE_WITH_APPROVED_PROVIDER_NAME
PUBLIC_LEGAL_BUSINESS_NAME=IoCode SOLUTIONS
PUBLIC_LEGAL_FORM=REPLACE_WITH_LEGAL_FORM
PUBLIC_LEGAL_REPRESENTATIVE=REPLACE_WITH_LEGAL_REPRESENTATIVE
PUBLIC_LEGAL_STREET=REPLACE_WITH_STREET_AND_HOUSE_NUMBER
PUBLIC_LEGAL_POSTAL_CODE=REPLACE_WITH_POSTAL_CODE
PUBLIC_LEGAL_CITY=Aachen
PUBLIC_LEGAL_COUNTRY=Germany
PUBLIC_LEGAL_EMAIL=contact@iocode-solutions.com
PUBLIC_PRIVACY_EMAIL=contact@iocode-solutions.com
PUBLIC_LEGAL_PHONE=
PUBLIC_LEGAL_VAT_ID=
PUBLIC_LEGAL_REGISTER_NAME=
PUBLIC_LEGAL_REGISTER_NUMBER=
PUBLIC_PRIVACY_AUTHORITY_NAME=Landesbeauftragte für Datenschutz und Informationsfreiheit Nordrhein-Westfalen
PUBLIC_PRIVACY_AUTHORITY_URL=https://www.ldi.nrw.de/kontakt/ihre-beschwerde
PUBLIC_HOSTING_PROVIDER=REPLACE_WITH_VERIFIED_HOSTING_PROVIDER
PUBLIC_HOSTING_LOCATION=REPLACE_WITH_PROCESSING_COUNTRY_OR_REGION
PUBLIC_HOSTING_TRANSFER_SAFEGUARD=REPLACE_WITH_EEA_DPF_OR_SCC_TIA
PUBLIC_EMAIL_PROVIDER=REPLACE_WITH_VERIFIED_EMAIL_PROVIDER
PUBLIC_EMAIL_LOCATION=REPLACE_WITH_PROCESSING_COUNTRY_OR_REGION
PUBLIC_EMAIL_TRANSFER_SAFEGUARD=REPLACE_WITH_EEA_DPF_OR_SCC_TIA
PUBLIC_DNS_PROVIDER=REPLACE_WITH_VERIFIED_DNS_OR_CDN_PROVIDER
PUBLIC_DNS_LOCATION=REPLACE_WITH_PROCESSING_COUNTRY_OR_REGION
PUBLIC_DNS_TRANSFER_SAFEGUARD=REPLACE_WITH_EEA_DPF_OR_SCC_TIA
PUBLIC_REGISTRAR_PROVIDER=REPLACE_WITH_VERIFIED_DOMAIN_REGISTRAR
PUBLIC_REGISTRAR_LOCATION=REPLACE_WITH_PROCESSING_COUNTRY_OR_REGION
PUBLIC_REGISTRAR_TRANSFER_SAFEGUARD=REPLACE_WITH_EEA_DPF_OR_SCC_TIA
TLS_FULLCHAIN_PATH=/etc/letsencrypt/live/iocode-solutions.com/fullchain.pem
TLS_PRIVKEY_PATH=/etc/letsencrypt/live/iocode-solutions.com/privkey.pem
RELEASE_ROOT=/opt/iocode/releases
RELEASE_ID=REPLACE_WITH_GIT_SHA
ASTRO_TELEMETRY_DISABLED=1
