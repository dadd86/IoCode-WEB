    "docker:build": "npm run build",
    "docker:audit:prod": "npm run audit:prod",
    "docker:validate": "npm run check && npm run build && npm run audit:prod"
  },
  "dependencies": {
    "astro": "^6.4.8",
    "three": "0.184.0"
  },
  "overrides": {
