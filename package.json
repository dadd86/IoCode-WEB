    "cookie": "0.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "1.60.0",
    "@types/three": "^0.184.1",
    "axe-core": "4.10.0",
    "lighthouse": "12.6.1",
