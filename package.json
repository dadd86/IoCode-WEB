{
  "name": "iocode-solutions-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "qa": "npm run check && npm run build && npm run audit:prod",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "qa:static": "node tools/qa-static-phase-1-1c.mjs",
    "qa:static:1.1d": "node tools/qa-static-phase-1-1d.mjs",
    "qa:browser": "playwright test",
    "qa:lighthouse": "node tools/lighthouse-phase-1-1c.mjs",
    "qa:phase-1-1c": "npm run build && npm run qa:static && npm run qa:browser && npm run qa:lighthouse",
    "qa:phase-1-1d": "npm run build && npm run qa:static && npm run qa:static:1.1d && npm run check && npm run audit:prod"
  },
  "dependencies": {
    "astro": "6.4.2",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/three": "^0.184.1",
    "typescript": "6.0.3"
  }
}