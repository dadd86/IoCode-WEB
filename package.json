{
  "name": "iocode-solutions-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "qa": "npm run check && npm run build && npm run audit:prod",
    "audit:prod": "npm audit --omit=dev",
    "audit:prod:strict": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "typecheck:tests": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "clean:visual:1.1b": "node tools/clean-phase-1-1b.mjs",
    "summary:visual:1.1b": "node tools/create-phase-1-1b-summary.mjs",
    "qa:visual:1.1b": "playwright test tests/e2e/phase-1-1b-visual.spec.ts --project=chromium-desktop --project=chromium-mobile",
    "qa:phase-1-1b": "npm run clean:visual:1.1b && npm run typecheck:tests && npm run qa:visual:1.1b && npm run summary:visual:1.1b",
    "clean:seo:1.1c": "node tools/clean-phase-1-1c.mjs",
    "qa:static:1.1c": "node tools/qa-static-phase-1-1c.mjs",
    "qa:lighthouse:1.1c": "node tools/lighthouse-phase-1-1c.mjs",
    "qa:phase-1-1c": "npm run check && npm run build && npm run audit:prod && npm run clean:seo:1.1c && npm run qa:static:1.1c && npm run qa:lighthouse:1.1c",
    "clean:local-artifacts": "node tools/clean-local-artifacts.mjs",
    "validate:dist-sitemap": "node tools/validate-dist-sitemap.mjs",
    "clean:security:1.1d": "node tools/clean-phase-1-1d.mjs",
    "qa:static:1.1d": "node tools/qa-static-phase-1-1d.mjs",
    "qa:headers:1.1d": "node tools/qa-security-headers-phase-1-1d.mjs",
    "qa:privacy:1.1d": "node tools/qa-privacy-surface-phase-1-1d.mjs",
    "qa:release-hygiene:1.1d": "node tools/qa-release-hygiene-phase-1-1d.mjs",
    "summary:security:1.1d": "node tools/create-phase-1-1d-summary.mjs",
    "qa:phase-1-1d": "npm run check && npm run build && npm run audit:prod && npm run clean:security:1.1d && npm run qa:static:1.1d && npm run qa:headers:1.1d && npm run qa:privacy:1.1d && npm run qa:release-hygiene:1.1d && npm run summary:security:1.1d",
    "docker:check": "npm run check",
    "docker:build": "npm run build",
    "docker:audit:prod": "npm run audit:prod",
    "docker:validate": "npm run check && npm run build && npm run audit:prod"
  },
  "dependencies": {
    "astro": "^6.4.8",
    "three": "0.184.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "yaml": "2.8.3",
    "cookie": "0.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "1.60.0",
    "@types/node": "^26.0.0",
    "@types/three": "^0.184.1",
    "axe-core": "4.10.0",
    "lighthouse": "12.6.1",
    "playwright": "1.60.0",
    "typescript": "6.0.3"
  }
}
