[Unit]
Description=Delete expired IoCode observability exports
Documentation=file:///srv/iocode/current/docs/OBSERVABILITY.md

[Service]
Type=oneshot
User=root
Group=root
Environment=OBSERVABILITY_LOG_ROOT=/var/log/iocode-observability
ExecStart=/bin/sh /srv/iocode/current/tools/prune-observability-logs.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/iocode-observability
