ASTRO_DEV_PORT=4321
ASTRO_PREVIEW_PORT=4322
WEB_PORT=8080
PUBLIC_DEPLOY_ENV=local
PUBLIC_SITE_URL=http://localhost:4321
# La identidad y el contenido legal (§5 DDG, RGPD) se versionan en
# src/data/legal-profile.ts y src/data/legal.ts; no dependen de variables de entorno.
ENABLE_HSTS=false
ENABLE_COOP=false
ENABLE_UPGRADE_INSECURE_REQUESTS=false
NODE_ENV=development
ASTRO_TELEMETRY_DISABLED=1
