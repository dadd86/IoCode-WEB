# syntax=docker/dockerfile:1.7

ARG PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.60.0-noble@sha256:9bd26ad900bb5e0f4dee75839e957a89ae89c2b7ab1e76050e559790e946b948
FROM ${PLAYWRIGHT_IMAGE}

ARG NPM_VERSION=11.16.0

WORKDIR /app

RUN npm install --global "npm@${NPM_VERSION}" \
  && npm --version

ENV CI=1 \
    ASTRO_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_BASE_URL=http://web:8080 \
    LIGHTHOUSE_BASE_URL=http://web:8080 \
    PERFORMANCE_BASE_URL=http://web:8080 \
    CHROME_PATH=/usr/local/bin/chromium

RUN set -eux; \
  sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources; \
  sed -i 's|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources; \
  apt-get -o Acquire::Retries=5 update; \
  apt-get install -y --no-install-recommends \
    ca-certificates \
    imagemagick \
    jq \
    gzip \
    brotli; \
  rm -rf /var/lib/apt/lists/*

COPY package*.json .npmrc ./

RUN npm ci \
  && npx playwright --version \
  && node -e "import('gltf-validator').then(() => console.log('gltf-validator ok'))" \
  && node -e "import('chrome-launcher').then(() => console.log('chrome-launcher ok'))" \
  && CHROME_BIN="$(find /ms-playwright -path '*/chrome-linux*/chrome' -type f | head -n 1)" \
  && test -n "$CHROME_BIN" \
  && ln -sf "$CHROME_BIN" /usr/local/bin/chromium \
  && test -x /usr/local/bin/chromium \
  && /usr/local/bin/chromium --version

COPY . .

CMD ["npm", "run", "internal:qa:phase-6"]
