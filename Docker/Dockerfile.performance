# syntax=docker/dockerfile:1.7

ARG PLAYWRIGHT_VERSION=1.60.0
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble

WORKDIR /app

ENV CI=1 \
    ASTRO_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_BASE_URL=http://web:8080 \
    LIGHTHOUSE_BASE_URL=http://web:8080 \
    PERFORMANCE_BASE_URL=http://web:8080 \
    CHROME_PATH=/usr/local/bin/chromium

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    imagemagick \
    jq \
    gzip \
    brotli \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

RUN npm ci \
  && npx playwright --version \
  && ./node_modules/.bin/gltf-transform --version \
  && node -e "import('gltf-validator').then(() => console.log('gltf-validator ok'))" \
  && node -e "import('chrome-launcher').then(() => console.log('chrome-launcher ok'))" \
  && CHROME_BIN="$(find /ms-playwright -path '*/chrome-linux*/chrome' -type f | head -n 1)" \
  && test -n "$CHROME_BIN" \
  && ln -sf "$CHROME_BIN" /usr/local/bin/chromium \
  && test -x /usr/local/bin/chromium \
  && /usr/local/bin/chromium --version

COPY . .

CMD ["npm", "run", "qa:phase-6"]