# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd
FROM ${NODE_IMAGE} AS build

ARG PUBLIC_DEPLOY_ENV=production
ARG PUBLIC_SITE_URL=https://iocode-solutions.com
ARG PUBLIC_LEGAL_APPROVED=false
ARG PUBLIC_PRIVACY_APPROVED=false
ARG PUBLIC_PRIVACY_AUTHORITY_NAME
ARG PUBLIC_PRIVACY_AUTHORITY_URL
ARG PUBLIC_HOSTING_PROVIDER
ARG PUBLIC_HOSTING_LOCATION
ARG PUBLIC_HOSTING_TRANSFER_SAFEGUARD
ARG PUBLIC_EMAIL_PROVIDER
ARG PUBLIC_EMAIL_LOCATION
ARG PUBLIC_EMAIL_TRANSFER_SAFEGUARD
ARG PUBLIC_DNS_PROVIDER
ARG PUBLIC_DNS_LOCATION
ARG PUBLIC_DNS_TRANSFER_SAFEGUARD
ARG PUBLIC_REGISTRAR_PROVIDER
ARG PUBLIC_REGISTRAR_LOCATION
ARG PUBLIC_REGISTRAR_TRANSFER_SAFEGUARD

WORKDIR /app

ENV NODE_ENV=development
ENV ASTRO_TELEMETRY_DISABLED=1
ENV PUBLIC_DEPLOY_ENV=${PUBLIC_DEPLOY_ENV}
ENV PUBLIC_SITE_URL=${PUBLIC_SITE_URL}
ENV PUBLIC_LEGAL_APPROVED=${PUBLIC_LEGAL_APPROVED}
ENV PUBLIC_PRIVACY_APPROVED=${PUBLIC_PRIVACY_APPROVED}
ENV PUBLIC_PRIVACY_AUTHORITY_NAME=${PUBLIC_PRIVACY_AUTHORITY_NAME}
ENV PUBLIC_PRIVACY_AUTHORITY_URL=${PUBLIC_PRIVACY_AUTHORITY_URL}
ENV PUBLIC_HOSTING_PROVIDER=${PUBLIC_HOSTING_PROVIDER}
ENV PUBLIC_HOSTING_LOCATION=${PUBLIC_HOSTING_LOCATION}
ENV PUBLIC_HOSTING_TRANSFER_SAFEGUARD=${PUBLIC_HOSTING_TRANSFER_SAFEGUARD}
ENV PUBLIC_EMAIL_PROVIDER=${PUBLIC_EMAIL_PROVIDER}
ENV PUBLIC_EMAIL_LOCATION=${PUBLIC_EMAIL_LOCATION}
ENV PUBLIC_EMAIL_TRANSFER_SAFEGUARD=${PUBLIC_EMAIL_TRANSFER_SAFEGUARD}
ENV PUBLIC_DNS_PROVIDER=${PUBLIC_DNS_PROVIDER}
ENV PUBLIC_DNS_LOCATION=${PUBLIC_DNS_LOCATION}
ENV PUBLIC_DNS_TRANSFER_SAFEGUARD=${PUBLIC_DNS_TRANSFER_SAFEGUARD}
ENV PUBLIC_REGISTRAR_PROVIDER=${PUBLIC_REGISTRAR_PROVIDER}
ENV PUBLIC_REGISTRAR_LOCATION=${PUBLIC_REGISTRAR_LOCATION}
ENV PUBLIC_REGISTRAR_TRANSFER_SAFEGUARD=${PUBLIC_REGISTRAR_TRANSFER_SAFEGUARD}

RUN apk add --no-cache gcompat \
  && node --version \
  && npm --version

COPY package*.json .npmrc ./

RUN test -f package.json || { echo "ERROR: package.json no existe en la raiz del proyecto." >&2; exit 64; }

RUN npm ci

COPY . .

RUN npm run check
RUN npm run build


FROM ${NODE_IMAGE} AS runtime

ARG RELEASE_VERSION=0.0.0
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG ARTIFACT_NAME=unknown
ARG ARTIFACT_SHA256=unknown

LABEL org.opencontainers.image.title="IoCode SOLUTIONS Web" \
  org.opencontainers.image.version="${RELEASE_VERSION}" \
  org.opencontainers.image.revision="${VCS_REF}" \
  org.opencontainers.image.created="${BUILD_DATE}" \
  org.opencontainers.image.source="https://github.com/dadd86/IoCode-WEB" \
  com.iocode.release.artifact.name="${ARTIFACT_NAME}" \
  com.iocode.release.artifact.sha256="${ARTIFACT_SHA256}"

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080
ENV ASTRO_TELEMETRY_DISABLED=1

RUN apk add --no-cache gcompat \
  && node --version \
  && npm --version

COPY --from=build /app/dist ./dist
COPY Docker/node-static-server.mjs ./node-static-server.mjs

USER node

EXPOSE 8080

CMD ["node", "node-static-server.mjs"]
