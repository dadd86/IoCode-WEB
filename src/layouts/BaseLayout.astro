---
import "../assets/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../data/site";
import type { Locale } from "../i18n/config";
import type { RouteKey } from "../i18n/routes";
import { getAlternatePaths, getLocalizedPath } from "../i18n/routes";

type Props = {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
};

const { locale, routeKey, title, description } = Astro.props;
const alternatePaths = getAlternatePaths(routeKey);
const canonicalPath = getLocalizedPath(routeKey, locale);
const canonicalUrl = `${siteConfig.url}${canonicalPath}`;
const skipText = {
  es: "Saltar al contenido principal",
  en: "Skip to main content",
  de: "Zum Hauptinhalt springen"
};
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={`${siteConfig.url}${alternatePaths.es}`} />
    <link rel="alternate" hreflang="en" href={`${siteConfig.url}${alternatePaths.en}`} />
    <link rel="alternate" hreflang="de" href={`${siteConfig.url}${alternatePaths.de}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteConfig.url}${alternatePaths.es}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body>
    <a class="skipLink" href="#contenido">{skipText[locale]}</a>
    <Header locale={locale} activeKey={routeKey} />
    <main id="contenido">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
