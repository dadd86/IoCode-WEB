---
import "../assets/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { siteConfig } from "../data/site";
import type { Locale } from "../i18n/config";
import type { RouteKey } from "../i18n/routes";
import { getAlternatePaths, getLocalizedPath, routeAlternates } from "../i18n/routes";

type Props = {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  robots?: string;
  refreshTo?: string;
  refreshDelay?: number;
};

const {
  locale,
  routeKey,
  title,
  description,
  robots = "index, follow, max-image-preview:large",
  refreshTo,
  refreshDelay = 0
} = Astro.props;
const alternatePaths = getAlternatePaths(routeKey);
const canonicalPath = getLocalizedPath(routeKey, locale);
const canonicalUrl = `${siteConfig.url}${canonicalPath}`;

const skipText: Record<Locale, string> = {
  es: "Saltar al contenido principal",
  en: "Skip to main content",
  de: "Zum Hauptinhalt springen"
};

const ogLocale: Record<Locale, string> = {
  es: "es_ES",
  en: "en_US",
  de: "de_DE"
};

const alternateOgLocales = Object.entries(ogLocale)
  .filter(([key]) => key !== locale)
  .map(([, value]) => value);

const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: siteConfig.name,
    item: `${siteConfig.url}${getLocalizedPath("home", locale)}`
  },
  ...(routeKey === "home"
    ? []
    : [
        {
          "@type": "ListItem",
          position: 2,
          name: routeAlternates[routeKey].label[locale],
          item: canonicalUrl
        }
      ])
];

const organizationSameAs =
  siteConfig.socialLinks.length > 0 ? { sameAs: siteConfig.socialLinks } : {};

const offerCatalogItems = siteConfig.offerCatalog.map((offer) => ({
  "@type": "Offer",
  itemOffered: {
    "@type": "Service",
    name: offer.name[locale],
    description: offer.description[locale],
    url: `${siteConfig.url}${getLocalizedPath(offer.routeKey, locale)}`,
    provider: {
      "@id": `${siteConfig.url}/#organization`
    },
    areaServed: [
      siteConfig.location.city,
      siteConfig.location.region,
      siteConfig.location.country,
      "European Union"
    ]
  }
}));

const pageTypeByRoute: Partial<Record<RouteKey, string>> = {
  services: "CollectionPage",
  about: "AboutPage",
  projects: "CollectionPage",
  skills: "CollectionPage",
  contact: "ContactPage"
};

const pageType = pageTypeByRoute[routeKey] ?? "WebPage";
const pageServiceOffer =
  routeKey === "plc" || routeKey === "robotics"
    ? siteConfig.offerCatalog.find((offer) => offer.routeKey === routeKey)
    : undefined;
const serviceEntityId = `${canonicalUrl}#service`;

const mainEntityId: Partial<Record<RouteKey, string>> = {
  services: `${siteConfig.url}/#professional-service`,
  plc: serviceEntityId,
  robotics: serviceEntityId,
  projects: `${canonicalUrl}#projects`,
  skills: `${canonicalUrl}#technical-skills`,
  contact: `${siteConfig.url}/#contact-person`
};

const structuredDataGraph: Array<Record<string, unknown>> = [
  {
    "@type": "Organization",
    "@id": `${siteConfig.url}/#organization`,
    name: siteConfig.name,
    legalName: siteConfig.legalName,
    url: siteConfig.url,
    email: siteConfig.email,
    logo: {
      "@type": "ImageObject",
      "@id": `${siteConfig.url}/#logo`,
      contentUrl: `${siteConfig.url}${siteConfig.logoPath}`,
      url: `${siteConfig.url}${siteConfig.logoPath}`,
      width: 512,
      height: 512,
      caption: siteConfig.name
    },
    description: siteConfig.businessDescription[locale],
    address: {
      "@type": "PostalAddress",
      addressLocality: siteConfig.location.city,
      addressRegion: siteConfig.location.region,
      addressCountry: siteConfig.location.country
    },
    contactPoint: {
      "@type": "ContactPoint",
      email: siteConfig.email,
      contactType: siteConfig.contactPoint.contactType[locale],
      availableLanguage: siteConfig.availableLanguages,
      areaServed: [
        siteConfig.location.city,
        siteConfig.location.region,
        siteConfig.location.country,
        "European Union"
      ]
    },
    ...organizationSameAs
  },
  {
    "@type": "ProfessionalService",
    "@id": `${siteConfig.url}/#professional-service`,
    name: siteConfig.name,
    legalName: siteConfig.legalName,
    url: siteConfig.url,
    email: siteConfig.email,
    image: {
      "@id": `${siteConfig.url}/#logo`
    },
    slogan: siteConfig.tagline[locale],
    description: siteConfig.businessDescription[locale],
    serviceType: siteConfig.serviceTypes[locale],
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: routeAlternates.services.label[locale],
      itemListElement: offerCatalogItems
    },
    areaServed: [
      siteConfig.location.city,
      siteConfig.location.region,
      siteConfig.location.country,
      "European Union"
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: siteConfig.location.city,
      addressRegion: siteConfig.location.region,
      addressCountry: siteConfig.location.country
    },
    ...organizationSameAs
  },
  {
    "@type": "WebSite",
    "@id": `${siteConfig.url}/#website`,
    name: siteConfig.name,
    url: siteConfig.url,
    inLanguage: locale,
    publisher: {
      "@id": `${siteConfig.url}/#organization`
    }
  },
  {
    "@type": pageType,
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    description,
    inLanguage: locale,
    isPartOf: {
      "@id": `${siteConfig.url}/#website`
    },
    ...(routeKey === "home"
      ? {}
      : {
          breadcrumb: {
            "@id": `${canonicalUrl}#breadcrumb`
          }
        }),
    about: {
      "@id": `${siteConfig.url}/#professional-service`
    },
    ...(mainEntityId[routeKey]
      ? {
          mainEntity: {
            "@id": mainEntityId[routeKey]
          }
        }
      : {})
  }
];

if (routeKey !== "home") {
  structuredDataGraph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbItems
  });
}

if (pageServiceOffer) {
  structuredDataGraph.push({
    "@type": "Service",
    "@id": serviceEntityId,
    name: pageServiceOffer.name[locale],
    description: pageServiceOffer.description[locale],
    url: canonicalUrl,
    serviceType: pageServiceOffer.name[locale],
    provider: {
      "@id": `${siteConfig.url}/#organization`
    },
    areaServed: [
      siteConfig.location.city,
      siteConfig.location.region,
      siteConfig.location.country,
      "European Union"
    ]
  });
}

if (routeKey === "contact") {
  structuredDataGraph.push({
    "@type": "Person",
    "@id": `${siteConfig.url}/#contact-person`,
    name: siteConfig.contactPerson.name,
    alternateName: siteConfig.contactPerson.shortName,
    jobTitle: siteConfig.contactPerson.role[locale],
    description: siteConfig.contactPerson.description[locale],
    worksFor: {
      "@id": `${siteConfig.url}/#organization`
    },
    sameAs: [
      siteConfig.contactPerson.links.linkedin,
      siteConfig.contactPerson.links.github
    ],
    knowsAbout: siteConfig.contactPerson.knowsAbout[locale],
    address: {
      "@type": "PostalAddress",
      addressLocality: siteConfig.location.city,
      addressRegion: siteConfig.location.region,
      addressCountry: siteConfig.location.country
    }
  });
}

const structuredData = {
  "@context": "https://schema.org",
  "@graph": structuredDataGraph
};
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#020617" />
    <meta name="application-name" content={siteConfig.name} />
    {refreshTo && <meta http-equiv="refresh" content={`${refreshDelay}; url=${refreshTo}`} />}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={`${siteConfig.url}${alternatePaths.es}`} />
    <link rel="alternate" hreflang="en" href={`${siteConfig.url}${alternatePaths.en}`} />
    <link rel="alternate" hreflang="de" href={`${siteConfig.url}${alternatePaths.de}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteConfig.url}${alternatePaths.es}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={`${siteConfig.url}${siteConfig.logoPath}`} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content={siteConfig.name} />
    {alternateOgLocales.map((alternateLocale) => (
      <meta property="og:locale:alternate" content={alternateLocale} />
    ))}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteConfig.url}${siteConfig.logoPath}`} />
    <meta name="twitter:image:alt" content={siteConfig.name} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skipLink" href="#contenido">{skipText[locale]}</a>
    <Header locale={locale} activeKey={routeKey} />
    <main id="contenido">
      {routeKey !== "home" && <Breadcrumbs locale={locale} routeKey={routeKey} />}
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
