---
import type { Locale } from "../i18n/config";
import type { RouteKey } from "../i18n/routes";
import { getAlternatePaths } from "../i18n/routes";
import { ui } from "../i18n/ui";

type Props = {
  locale: Locale;
  activeKey: RouteKey;
  paths?: Record<Locale, string>;
};
const { locale, activeKey, paths: pathsOverride } = Astro.props;
const paths = pathsOverride ?? getAlternatePaths(activeKey);
const labels = ui[locale];
---

<div class="languageSwitcher" aria-label={labels.languageSelectorLabel}>
  <a
    class:list={{ "is-active": locale === "es" }}
    href={paths.es}
    hreflang="es"
    lang="es"
    aria-label={labels.languageLinkEs}
    aria-current={locale === "es" ? "true" : undefined}
  >
    ES
  </a>
  <a
    class:list={{ "is-active": locale === "en" }}
    href={paths.en}
    hreflang="en"
    lang="en"
    aria-label={labels.languageLinkEn}
    aria-current={locale === "en" ? "true" : undefined}
  >
    EN
  </a>
  <a
    class:list={{ "is-active": locale === "de" }}
    href={paths.de}
    hreflang="de"
    lang="de"
    aria-label={labels.languageLinkDe}
    aria-current={locale === "de" ? "true" : undefined}
  >
    DE
  </a>
</div>
