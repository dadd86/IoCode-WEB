---
type Variant = "primary" | "secondary" | "ghost";
type Props = { href: string; label: string; variant?: Variant; external?: boolean };
const { href, label, variant = "primary", external = false } = Astro.props;
---

<a class={`button button--${variant}`} href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{label}</a>
