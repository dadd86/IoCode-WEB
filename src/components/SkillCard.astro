---
import type { Locale } from "../i18n/config";
import type { SkillGroup } from "../data/skills";
import { getProjectByKey } from "../data/projects";
import { getLocalizedPath, routeAlternates } from "../i18n/routes";

type Props = {
  skill: SkillGroup;
  labels: Record<string, string>;
  locale: Locale;
  tabId?: string;
  active?: boolean;
};

const { skill, labels, locale, tabId, active = false } = Astro.props;
---

<article
  class="skillBlock"
  id={skill.slug}
  role={tabId ? "tabpanel" : undefined}
  aria-labelledby={tabId}
  aria-hidden={tabId ? !active : undefined}
  tabindex={tabId ? (active ? 0 : -1) : undefined}
  inert={tabId && !active ? true : undefined}
  data-page-control-panel={tabId ? "" : undefined}
>
  <div class="skillBlock__header">
    {/* The eyebrow shows the skill's own proficiency level rather than the
       internal `searchIntent` SEO field, which stays in the data model for
       governance/testing but is never rendered to visitors. */}
    <p class="skillBlock__intent">{skill.proficiency}</p>
    <h2>{skill.title}</h2>
  </div>

  <dl class="skillEvidence">
    <div>
      <dt>{labels.skillBusinessProblem}</dt>
      <dd>{skill.businessProblem}</dd>
    </div>

    <div>
      <dt>{labels.skillBusinessValue}</dt>
      <dd>{skill.businessValue}</dd>
    </div>

    <div>
      <dt>{labels.skillEvidence}</dt>
      <dd>{skill.evidence}</dd>
    </div>
  </dl>

  <section class="skillBlock__section" aria-label={labels.skillTechnologies}>
    <h3>{labels.skillTechnologies}</h3>
    <div class="pillGroup">
      {skill.technologies.map((technology) => <span>{technology}</span>)}
    </div>
  </section>

  <section class="skillBlock__section" aria-label={labels.skillUseCases}>
    <h3>{labels.skillUseCases}</h3>
    <ul class="skillUseCases">
      {skill.useCases.map((useCase) => <li>{useCase}</li>)}
    </ul>
  </section>

  <section class="skillBlock__section" aria-label={labels.skillRelatedServices}>
    <h3>{labels.skillRelatedServices}</h3>
    <div class="skillLinks">
      {skill.relatedServices.map((routeKey) => (
        <a href={getLocalizedPath(routeKey, locale)}>{routeAlternates[routeKey].label[locale]}</a>
      ))}
    </div>
  </section>

  {skill.relatedProjects.length > 0 && (
    <section class="skillBlock__section" aria-label={labels.skillRelatedProjects}>
      <h3>{labels.skillRelatedProjects}</h3>
      <div class="skillLinks">
        {skill.relatedProjects.map((projectKey) => {
          const relatedProject = getProjectByKey(projectKey, locale);
          return (
            <a href={relatedProject.path}>
              {relatedProject.title}
            </a>
          );
        })}
      </div>
    </section>
  )}

  <p class="skillScope">
    <strong>{labels.scope}</strong>
    {skill.scope}
  </p>
</article>

<script>
  import "../scripts/skill-spotlight";
</script>
