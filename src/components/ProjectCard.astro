---
import type { Project, ProjectCapability } from "../data/projects";

type Props = {
  project: Project;
  labels: Record<string, string>;
  tabId?: string;
  active?: boolean;
  detailHref?: string;
};

const { project, labels, tabId, active = false, detailHref } = Astro.props;

// ProjectCapability is an internal kebab-case slug; map it to the matching
// `labels.capability*` key so the tag never renders the raw identifier.
const capabilityLabelKeys: Record<ProjectCapability, string> = {
  "industrial-web": "capabilityIndustrialWeb",
  "mobile-development": "capabilityMobileDevelopment",
  "devsecops-docker": "capabilityDevsecopsDocker",
  "database-design": "capabilityDatabaseDesign",
  "software-architecture": "capabilitySoftwareArchitecture",
  "java-oop": "capabilityJavaOop",
  "quality-assurance": "capabilityQualityAssurance",
  "erp-integration": "capabilityErpIntegration",
  "python-development": "capabilityPythonDevelopment"
};
---

<article
  class="projectCard"
  id={project.slug}
  role={tabId ? "tabpanel" : undefined}
  aria-labelledby={tabId}
  aria-hidden={tabId ? !active : undefined}
  tabindex={tabId ? (active ? 0 : -1) : undefined}
  inert={tabId && !active ? true : undefined}
  data-page-control-panel={tabId ? "" : undefined}
>
  <div class="projectCard__top">
    <span class="projectCard__type">{project.type}</span>
    {/* claimLevel is an internal governance enum; the chip shows its
       human-readable label instead of the raw "verified"/"technical-demonstration"
       value. */}
    <span class="projectCard__status">
      {project.claimLevel === "verified" ? labels.claimLevelVerified : labels.claimLevelTechnicalDemonstration}
    </span>
  </div>

  <div class="projectCard__body">
    <h2>{project.title}</h2>

    <p>{project.summary}</p>

    <dl class="projectEvidence">
      <div>
        <dt>{labels.projectProblem}</dt>
        <dd>{project.problem}</dd>
      </div>

      <div>
        <dt>{labels.projectSolution}</dt>
        <dd>{project.solution}</dd>
      </div>

      <div>
        <dt>{labels.projectRole}</dt>
        <dd>{project.technicalRole}</dd>
      </div>

      <div>
        <dt>{labels.projectBusinessValue}</dt>
        <dd>{project.businessValue}</dd>
      </div>

      <div>
        <dt>{labels.projectEvidenceSummary}</dt>
        <dd>{project.evidenceSummary}</dd>
      </div>
    </dl>

    <div class="tagList" aria-label={labels.projectTechnologies}>
      {project.technologies.map((technology) => (
        <span class="tag">{technology}</span>
      ))}
    </div>

    <div class="tagList" aria-label={labels.projectCapabilities}>
      {project.capabilities.map((capability) => (
        <span class="tag tag--secondary">{labels[capabilityLabelKeys[capability]]}</span>
      ))}
    </div>

    <p class="projectNote">
      <strong>{labels.scope}</strong>
      {project.scope}
    </p>

    {detailHref ? (
      <p class="projectLinks">
        <a href={detailHref}>{labels.projectReadCaseStudy}</a>
      </p>
    ) : null}

    {project.publicLinks.length > 0 ? (
      <div class="projectLinks">
        {project.publicLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    ) : (
      <p class="projectNoPublicLink">{labels.projectNoPublicLink}</p>
    )}
  </div>
</article>
