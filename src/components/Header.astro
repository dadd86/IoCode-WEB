---
import Navigation from "./Navigation.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LogoImage from "./LogoImage.astro";
import { siteConfig } from "../data/site";
import type { Locale } from "../i18n/config";
import type { RouteKey } from "../i18n/routes";
import { ui } from "../i18n/ui";

/**
 * Propósito:
 * Renderizar el encabezado principal con navegación desktop y un menú
 * hamburguesa nativo para móvil y tablet.
 *
 * Tipos de datos:
 * - locale: idioma activo.
 * - activeKey: ruta activa.
 *
 * Parámetros:
 * Propiedades Astro del componente.
 *
 * Retorno:
 * HTML semántico accesible sin JavaScript de navegación.
 *
 * Notas:
 * El menú móvil usa details/summary para funcionar incluso con JavaScript
 * desactivado y evitar una nueva dependencia de hidratación.
 */

type Props = {
  locale: Locale;
  activeKey: RouteKey;
  alternatePaths?: Record<Locale, string>;
};

const { locale, activeKey, alternatePaths } =
  Astro.props as Props;
const labels = ui[locale];
---

<header class="siteHeader">
  <nav
    class="navbar container"
    aria-label={labels.headerNavLabel}
  >
    <a
      class="brand"
      href={`/${locale}/`}
      aria-label={labels.headerBrandLabel}
    >
      <LogoImage
        imgClass="brand__logo"
        alt={siteConfig.name}
        loading="eager"
        fetchPriority="high"
        sizes="96px"
      />
    </a>

    <div class="desktopNavigation">
      <Navigation
        locale={locale}
        activeKey={activeKey}
        variant="desktop"
      />
    </div>

    <div class="desktopLanguage">
      <LanguageSwitcher
        locale={locale}
        activeKey={activeKey}
        paths={alternatePaths}
      />
    </div>

    <details class="mobileMenu">
      <summary
        class="mobileMenu__toggle"
        aria-label={labels.headerMenuLabel}
      >
        <span class="mobileMenu__icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>

        <span class="mobileMenu__label">
          {labels.headerMenuText}
        </span>
      </summary>

      <div class="mobileMenu__panel">
        <Navigation
          locale={locale}
          activeKey={activeKey}
          variant="mobile"
        />

        <LanguageSwitcher
          locale={locale}
          activeKey={activeKey}
          paths={alternatePaths}
        />
      </div>
    </details>
  </nav>
</header>
