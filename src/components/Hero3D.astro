---
import { getHeroPanels } from "../data/heroPanels";
import { siteConfig } from "../data/site";
import type { Locale } from "../i18n/config";
import { getLocalizedPath } from "../i18n/routes";
import LogoImage from "./LogoImage.astro";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props as Props;

const panels = getHeroPanels(locale).map((panel) => ({
  ...panel,
  href: getLocalizedPath(panel.routeKey, locale)
}));

const secondaryPanels = panels.filter((panel) => panel.priority !== "primary");

const fallbackMessage: Record<Locale, string> = {
  es: "La escena 3D no se pudo cargar. La navegación sigue disponible mediante los enlaces del hero.",
  en: "The 3D scene could not be loaded. Navigation remains available through the hero links.",
  de: "Die 3D-Szene konnte nicht geladen werden. Die Navigation bleibt über die Hero-Links verfügbar."
};

const heroAriaLabel: Record<Locale, string> = {
  es: "Hero interactivo 3D de IoCode SOLUTIONS",
  en: "IoCode SOLUTIONS interactive 3D hero",
  de: "Interaktiver 3D-Hero von IoCode SOLUTIONS"
};

const panelsAriaLabel: Record<Locale, string> = {
  es: "Áreas técnicas de IoCode SOLUTIONS",
  en: "IoCode SOLUTIONS technical areas",
  de: "Technische Bereiche von IoCode SOLUTIONS"
};

const secondaryPanelsAriaLabel: Record<Locale, string> = {
  es: "Áreas técnicas secundarias de IoCode SOLUTIONS",
  en: "IoCode SOLUTIONS secondary technical areas",
  de: "Sekundäre technische Bereiche von IoCode SOLUTIONS"
};

const panelFallbackCss = panels
  .map(
    (panel) =>
      `.hero3d__panel[data-panel-id="${panel.id}"]{--panel-x:${panel.screenFallback.x}%;--panel-y:${panel.screenFallback.y}%;}`
  )
  .join("\n");
---
<style is:inline set:html={panelFallbackCss}></style>
<div
  class="hero3d__scene"
  data-hero3d
  data-hero3d-state="deferred"
  data-language={locale}
  data-model-url={siteConfig.logo3dPath}
  data-fallback-logo-url={siteConfig.logoPath}
  aria-label={heroAriaLabel[locale]}
>
  <div class="hero3d__stage" data-hero-stage>
    <div class="hero3d__viewer" data-hero-viewer aria-hidden="true"></div>

    <div class="hero3d__placeholder" data-hero-placeholder aria-hidden="true">
      <LogoImage
        alt=""
        loading="eager"
        fetchPriority="low"
        sizes="(max-width: 720px) 54vw, 18rem"
      />
    </div>

    <nav
      class="hero3d__panels"
      data-hero-panels
      aria-label={panelsAriaLabel[locale]}
    >
      {panels.map((panel) => (
        <a
          class="hero3d__panel"
          href={panel.href}
          aria-label={`${panel.copy.title} — ${panel.copy.text}. ${panel.copy.description}`}
          lang={locale}
          data-panel-id={panel.id}
          data-priority={panel.priority}
          data-desktop-visible={String(panel.desktopVisible)}
          data-tablet-visible={String(panel.tabletVisible)}
          data-mobile-visible={String(panel.mobileVisible)}
          data-fallback-x={String(panel.screenFallback.x)}
          data-fallback-y={String(panel.screenFallback.y)}
          data-parallax={String(panel.motion.parallax)}
        >
          <strong class="hero3d__panel-title">{panel.copy.title}</strong>
          <span class="hero3d__panel-text">{panel.copy.text}</span>
          <span class="hero3d__panel-description">{panel.copy.description}</span>
        </a>
      ))}
    </nav>

    <nav
      class="hero3d__mobileDock"
      aria-label={secondaryPanelsAriaLabel[locale]}
    >
      {secondaryPanels.map((panel) => (
        <a
          href={panel.href}
          aria-label={`${panel.copy.title} — ${panel.copy.text}. ${panel.copy.description}`}
          lang={locale}
          data-mobile-dock-panel={panel.id}
        >
          <strong>{panel.copy.title}</strong>
          <span>{panel.copy.text}</span>
        </a>
      ))}
    </nav>

    <div class="hero3d__fallback" data-hero-fallback>
      <div>
        <LogoImage
          alt="IoCode SOLUTIONS"
          loading="eager"
          fetchPriority="low"
          sizes="(max-width: 720px) 58vw, 29rem"
        />
        <p data-hero-fallback-message>{fallbackMessage[locale]}</p>
      </div>
    </div>

    <div class="hero3d__gridLines" aria-hidden="true"></div>
  </div>
</div>

<script>
  import "../scripts/hero3d-loader";
</script>