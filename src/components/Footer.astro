---
import { siteConfig } from "../data/site";
import type { Locale } from "../i18n/config";

type Props = { locale: Locale };
const { locale } = Astro.props;
const text = {
  es: "Software, automatizacion industrial, robotica e Industria 4.0.",
  en: "Software, industrial automation, robotics and Industry 4.0.",
  de: "Software, industrielle Automatisierung, Robotik und Industrie 4.0."
};
---

<footer class="siteFooter">
  <div class="container footerContent">
    <a href={`/${locale}/`} aria-label="IoCode SOLUTIONS">
      <img class="footerLogo" src={siteConfig.logoPath} alt="IoCode SOLUTIONS" />
    </a>
    <p>© {new Date().getFullYear()} IoCode SOLUTIONS. {text[locale]}</p>
  </div>
</footer>
