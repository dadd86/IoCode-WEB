---
import { siteConfig } from "../data/site";
import type { Locale } from "../i18n/config";
import LogoImage from "./LogoImage.astro";
import { getLocalizedPath } from "../i18n/routes";
import { ui } from "../i18n/ui";
type Props = { locale: Locale };
const { locale } = Astro.props;
const labels = ui[locale];
---

<footer class="siteFooter" aria-label={labels.footerLabel}>
  <div class="container footerContent">
    <a href={`/${locale}/`} aria-label={siteConfig.name}>
      <LogoImage
        imgClass="footerLogo"
        alt={siteConfig.name}
        loading="eager"
        fetchPriority="low"
        sizes="112px"
        width={128}
        height={128}
      />
    </a>
    <div class="footerText">
      <p>© {new Date().getFullYear()} {siteConfig.name}. {labels.footerText}</p>
      <nav class="footerLegal" aria-label={labels.footerLegalLabel}>
        <a href={getLocalizedPath("imprint", locale)}>{labels.footerImprint}</a>
        <a href={getLocalizedPath("privacy", locale)}>{labels.footerPrivacy}</a>
      </nav>
    </div>
  </div>
</footer>
