---
import { siteConfig } from "../data/site";
import type { Locale } from "../i18n/config";
import LogoImage from "./LogoImage.astro";
import { getLocalizedPath } from "../i18n/routes";
type Props = { locale: Locale };
const { locale } = Astro.props;

const text: Record<Locale, string> = {
  es: "Automatización industrial, PLC, robótica, software e Industria 4.0.",
  en: "Industrial automation, PLC, robotics, software and Industry 4.0.",
  de: "Industrielle Automatisierung, SPS, Robotik, Software und Industrie 4.0."
};

const footerLabel: Record<Locale, string> = {
  es: "Información del sitio y marca IoCode SOLUTIONS",
  en: "Site information and IoCode SOLUTIONS brand",
  de: "Website-Informationen und Marke IoCode SOLUTIONS"
};

const legalLabel: Record<Locale, string> = {
  es: "Información legal",
  en: "Legal information",
  de: "Rechtliche Informationen"
};

const legalLinks: Record<Locale, { imprint: string; privacy: string }> = {
  es: { imprint: "Aviso legal", privacy: "Política de privacidad" },
  en: { imprint: "Legal notice", privacy: "Privacy policy" },
  de: { imprint: "Impressum", privacy: "Datenschutzerklärung" }
};
---

<footer class="siteFooter" aria-label={footerLabel[locale]}>
  <div class="container footerContent">
    <a href={`/${locale}/`} aria-label={siteConfig.name}>
      <LogoImage
        imgClass="footerLogo"
        alt={siteConfig.name}
        loading="eager"
        fetchPriority="low"
        sizes="112px"
        width={128}
        height={128}
      />
    </a>
    <div class="footerText">
      <p>© {new Date().getFullYear()} {siteConfig.name}. {text[locale]}</p>
      <nav class="footerLegal" aria-label={legalLabel[locale]}>
        <a href={getLocalizedPath("imprint", locale)}>{legalLinks[locale].imprint}</a>
        <a href={getLocalizedPath("privacy", locale)}>{legalLinks[locale].privacy}</a>
      </nav>
    </div>
  </div>
</footer>
