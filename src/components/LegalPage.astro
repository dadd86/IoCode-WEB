---
import type { Locale } from "../i18n/config";
import { legalCopy } from "../data/legal";
import { legalConfig } from "../config/legal";

type Props = {
  locale: Locale;
  kind: "imprint" | "privacy";
};

const { locale, kind } = Astro.props as Props;
const copy = legalCopy[locale];
const address = [
  legalConfig.street,
  `${legalConfig.postalCode} ${legalConfig.city}`.trim(),
  legalConfig.country
].filter(Boolean);
const authorityAddress = [
  legalConfig.supervisoryAuthority.street,
  `${legalConfig.supervisoryAuthority.postalCode} ${legalConfig.supervisoryAuthority.city}`.trim(),
  legalConfig.supervisoryAuthority.country
].filter(Boolean);
---

<article class="legalPage">
  <div class="container legalPage__content">
    {kind === "imprint" ? (
      <>
        <section>
          <h2>{copy.providerTitle}</h2>
          <dl class="legalDetails">
            <div>
              <dt>{copy.labels.provider}</dt>
              <dd>{legalConfig.providerName}</dd>
            </div>
            <div>
              <dt>{copy.labels.businessDesignation}</dt>
              <dd>{copy.businessDesignationText}</dd>
            </div>
            <div>
              <dt>{copy.labels.legalForm}</dt>
              <dd>{legalConfig.legalForm}</dd>
            </div>
            <div>
              <dt>{copy.labels.address}</dt>
              <dd>{address.map((line) => <>{line}<br /></>)}</dd>
            </div>
            <div>
              <dt>{copy.labels.contact}</dt>
              <dd>
                <a href={`mailto:${legalConfig.email}`}>{legalConfig.email}</a>
                <br />
                <a href={`tel:${legalConfig.phone.replace(/\s+/g, "")}`}>{legalConfig.phone}</a>
              </dd>
            </div>
            <div>
              <dt>{copy.labels.vatId}</dt>
              <dd>{legalConfig.vatId}</dd>
            </div>
          </dl>
        </section>
        <section>
          <h2>{copy.disputeTitle}</h2>
          <p>{copy.disputeText}</p>
        </section>
      </>
    ) : (
      <>
        <section>
          <h2>{copy.providerTitle}</h2>
          <p>{copy.privacyIntro}</p>
          <p>{copy.businessDesignationText}</p>
          {address.map((line) => <p>{line}</p>)}
          <p><a href={`mailto:${legalConfig.email}`}>{legalConfig.email}</a></p>
        </section>
        {copy.privacySections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
          </section>
        ))}
        <section>
          <h2>{copy.authorityTitle}</h2>
          <p>{copy.authorityIntro}</p>
          <p>
            {legalConfig.supervisoryAuthority.name}<br />
            {authorityAddress.map((line) => <>{line}<br /></>)}
            <a href={legalConfig.supervisoryAuthority.url} rel="external">
              {legalConfig.supervisoryAuthority.url}
            </a>
          </p>
        </section>
        <section>
          <h2>{copy.versionTitle}</h2>
          <p><strong>{legalConfig.legalVersion}</strong></p>
          <p>{copy.versionSummary}</p>
        </section>
      </>
    )}

    <p class="legalPage__updated">{copy.lastUpdated}</p>
  </div>
</article>
