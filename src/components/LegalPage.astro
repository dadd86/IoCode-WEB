---
import type { Locale } from "../i18n/config";
import { legalCopy } from "../data/legal";
import {
  legalConfig,
  legalProfileComplete,
  missingRequiredLegalFields,
  publicProviderDisclosures
} from "../config/legal";

type Props = {
  locale: Locale;
  kind: "imprint" | "privacy";
};

const { locale, kind } = Astro.props as Props;
const copy = legalCopy[locale];
const address = [
  legalConfig.street,
  `${legalConfig.postalCode} ${legalConfig.city}`.trim(),
  legalConfig.country
].filter(Boolean);
---

<article class="legalPage" data-legal-status={legalProfileComplete ? "complete" : "draft"}>
  <div class="container legalPage__content">
    {!legalProfileComplete && (
      <aside class="legalNotice" role="status" aria-labelledby="legal-draft-title">
        <h2 id="legal-draft-title">{copy.incompleteTitle}</h2>
        <p>{copy.incompleteText}</p>
        <p><code>{missingRequiredLegalFields.join(", ")}</code></p>
      </aside>
    )}

    {kind === "imprint" ? (
      <>
        <section>
          <h2>{copy.providerTitle}</h2>
          <dl class="legalDetails">
            <div>
              <dt>{copy.providerName}</dt>
              <dd>{legalConfig.providerName}</dd>
            </div>
            <div>
              <dt>{copy.businessName}</dt>
              <dd>{legalConfig.businessName}</dd>
            </div>
            <div>
              <dt>{copy.legalForm}</dt>
              <dd>{legalConfig.legalForm || "—"}</dd>
            </div>
            <div>
              <dt>{copy.address}</dt>
              <dd>{address.length > 0 ? address.map((line) => <>{line}<br /></>) : "—"}</dd>
            </div>
            <div>
              <dt>{copy.contact}</dt>
              <dd>
                <a href={`mailto:${legalConfig.email}`}>{legalConfig.email}</a>
                {legalConfig.phone && <><br /><a href={`tel:${legalConfig.phone}`}>{legalConfig.phone}</a></>}
              </dd>
            </div>
            <div>
              <dt>{copy.privacyContact}</dt>
              <dd><a href={`mailto:${legalConfig.privacyEmail}`}>{legalConfig.privacyEmail}</a></dd>
            </div>
            {legalConfig.vatId && (
              <div>
                <dt>{copy.optionalRegistration}</dt>
                <dd>
                  <span>USt-IdNr.: {legalConfig.vatId}</span>
                </dd>
              </div>
            )}
          </dl>
        </section>
        <section>
          <h2>{copy.disputeTitle}</h2>
          <p>{copy.disputeText}</p>
        </section>
      </>
    ) : (
      <>
        <section>
          <h2>{copy.providerTitle}</h2>
          <p>{legalConfig.providerName}, {legalConfig.businessName}</p>
          {address.map((line) => <p>{line}</p>)}
          <p><a href={`mailto:${legalConfig.email}`}>{legalConfig.email}</a></p>
        </section>
        {copy.privacySections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
          </section>
        ))}
        <section>
          <h2>{copy.providerLabels.title}</h2>
          <div class="legalTableWrapper">
            <table>
              <thead>
                <tr>
                  <th scope="col">{copy.providerLabels.service}</th>
                  <th scope="col">{copy.providerLabels.provider}</th>
                  <th scope="col">{copy.providerLabels.location}</th>
                  <th scope="col">{copy.providerLabels.safeguard}</th>
                </tr>
              </thead>
              <tbody>
                {publicProviderDisclosures.map((provider) => (
                  <tr>
                    <th scope="row">{copy.providerLabels.services[provider.service]}</th>
                    <td>{provider.provider || copy.providerLabels.pending}</td>
                    <td>{provider.processingLocation || copy.providerLabels.pending}</td>
                    <td>{provider.transferSafeguard || copy.providerLabels.pending}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
        <section>
          <h2>{copy.authorityTitle}</h2>
          <p>{copy.authorityText}</p>
          {legalConfig.supervisoryAuthorityUrl && legalConfig.supervisoryAuthorityName ? (
            <p>
              <a href={legalConfig.supervisoryAuthorityUrl} rel="external">
                {legalConfig.supervisoryAuthorityName}
              </a>
            </p>
          ) : <p>{copy.providerLabels.pending}</p>}
        </section>
        <section>
          <h2>{copy.versionTitle}</h2>
          <p><strong>{legalConfig.legalVersion}</strong></p>
          <p>{copy.versionSummary}</p>
        </section>
      </>
    )}

    <p class="legalPage__updated">{copy.lastUpdated}</p>
  </div>
</article>
