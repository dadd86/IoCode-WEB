---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import Hero3D from "../../components/Hero3D.astro";
import PageHero from "../../components/PageHero.astro";
import CardGrid from "../../components/CardGrid.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SkillCard from "../../components/SkillCard.astro";
import ContactForm from "../../components/ContactForm.astro";
import BusinessValueSections from "../../components/BusinessValueSections.astro";
import ProcessMethod from "../../components/ProcessMethod.astro";
import { pageContent } from "../../data/pageContent";
import { projects } from "../../data/projects";
import { skillGroups } from "../../data/skills";
import { ui } from "../../i18n/ui";
import { getLocalizedPath, getStaticRouteParams } from "../../i18n/routes";
import type { Locale } from "../../i18n/config";
import type { RouteKey } from "../../i18n/routes";
import { siteConfig } from "../../data/site";

export function getStaticPaths() {
  return getStaticRouteParams();
}

const { locale, routeKey } = Astro.props as { locale: Locale; routeKey: RouteKey };
const content = pageContent[locale][routeKey];
const labels = ui[locale];

const routesWithStandardCards: RouteKey[] = ["services", "plc", "robotics", "about"];

const projectStructuredData =
  routeKey === "projects"
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "@id": `${siteConfig.url}${getLocalizedPath("projects", locale)}#projects`,
        name: content.heading,
        description: content.description,
        itemListElement: projects[locale].map((project, index) => ({
          "@type": "ListItem",
          position: index + 1,
          item: {
            "@type": "CreativeWork",
            "@id": `${siteConfig.url}${getLocalizedPath("projects", locale)}#${project.slug}`,
            name: project.title,
            description: project.summary,
            inLanguage: locale,
            genre: project.status,
            about: project.capabilities,
            url: `${siteConfig.url}${getLocalizedPath("projects", locale)}#${project.slug}`
          }
        }))
      }
    : null;
---

<BaseLayout locale={locale} routeKey={routeKey} title={content.title} description={content.description}>
  {routeKey === "home" ? (
    <>
      <section class="hero3d">
        <div class="container hero3d__grid">
          <div class="hero3d__content">
            <p class="eyebrow">{content.eyebrow}</p>
            <h1>{content.heading}</h1>
            <p class="hero3d__text">{content.intro}</p>
            <div class="buttonGroup">
              <Button href={getLocalizedPath("contact", locale)} label={labels.requestProposal} />
              <Button href={getLocalizedPath("projects", locale)} label={labels.viewProjects} variant="secondary" />
            </div>
          </div>
          <Hero3D locale={locale} />
        </div>
      </section>

      {content.cards && <CardGrid cards={content.cards} />}

      <BusinessValueSections locale={locale} variant="home" />
    </>
  ) : routeKey === "process" ? (
    <ProcessMethod locale={locale} />
  ) : (
    <PageHero eyebrow={content.eyebrow} title={content.heading} text={content.intro} />
  )}

  {routesWithStandardCards.includes(routeKey) ? (
    <>
      {content.cards && <CardGrid cards={content.cards} />}
      {routeKey === "services" && <BusinessValueSections locale={locale} variant="services" />}
    </>
  ) : null}

  {routeKey === "projects" ? (
    <section class="section">
      <div class="container projectGrid">
        {projects[locale].map((project) => <ProjectCard project={project} labels={labels} />)}
      </div>
    </section>
  ) : null}
  
  {projectStructuredData ? (
    <script type="application/ld+json" set:html={JSON.stringify(projectStructuredData)}></script>
  ) : null}

  {routeKey === "skills" ? (
    <section class="section">
      <div class="container skillMatrix">
        {skillGroups[locale].map((skill) => <SkillCard title={skill.title} text={skill.text} items={skill.items} />)}
      </div>
    </section>
  ) : null}

  {routeKey === "contact" ? (
    <section class="section">
      <div class="container">
        <ContactForm locale={locale} />
      </div>
    </section>
  ) : null}
</BaseLayout>