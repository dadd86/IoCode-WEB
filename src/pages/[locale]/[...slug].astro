---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeHero from "../../components/HomeHero.astro";
import PageHero from "../../components/PageHero.astro";
import CardGrid from "../../components/CardGrid.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SkillCard from "../../components/SkillCard.astro";
import ContactForm from "../../components/ContactForm.astro";
import BusinessValueSections from "../../components/BusinessValueSections.astro";
import ProcessMethod from "../../components/ProcessMethod.astro";
import { pageContent } from "../../data/pageContent";
import { projects } from "../../data/projects";
import { skillGroups } from "../../data/skills";
import { ui } from "../../i18n/ui";
import { getLocalizedPath, getStaticRouteParams } from "../../i18n/routes";
import type { Locale } from "../../i18n/config";
import type { RouteKey } from "../../i18n/routes";
import { siteConfig } from "../../data/site";

export function getStaticPaths() {
  return getStaticRouteParams();
}

const { locale, routeKey } = Astro.props as { locale: Locale; routeKey: RouteKey };
const content = pageContent[locale][routeKey];
const labels = ui[locale];

const routesWithStandardCards: RouteKey[] = ["services", "plc", "robotics", "about"];

const projectStructuredData =
  routeKey === "projects"
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "@id": `${siteConfig.url}${getLocalizedPath("projects", locale)}#projects`,
        name: content.heading,
        description: content.description,
        itemListElement: projects[locale].map((project, index) => ({
          "@type": "ListItem",
          position: index + 1,
          item: {
            "@type": "CreativeWork",
            "@id": `${siteConfig.url}${getLocalizedPath("projects", locale)}#${project.slug}`,
            name: project.title,
            description: project.summary,
            inLanguage: locale,
            genre: project.status,
            about: project.capabilities,
            url: `${siteConfig.url}${getLocalizedPath("projects", locale)}#${project.slug}`
          }
        }))
      }
    : null;

const skillStructuredData =
  routeKey === "skills"
    ? {
        "@context": "https://schema.org",
        "@type": "DefinedTermSet",
        "@id": `${siteConfig.url}${getLocalizedPath("skills", locale)}#technical-skills`,
        name: content.heading,
        description: content.description,
        inLanguage: locale,
        hasDefinedTerm: skillGroups[locale].map((skill) => ({
          "@type": "DefinedTerm",
          "@id": `${siteConfig.url}${getLocalizedPath("skills", locale)}#${skill.slug}`,
          name: skill.title,
          description: skill.businessProblem,
          termCode: skill.slug,
          inDefinedTermSet: `${siteConfig.url}${getLocalizedPath("skills", locale)}#technical-skills`
        }))
      }
    : null;
---

<BaseLayout locale={locale} routeKey={routeKey} title={content.title} description={content.description}>
  {routeKey === "home" ? (
    <>
      <HomeHero locale={locale} content={content} />

      {content.cards && <CardGrid cards={content.cards} />}

      <BusinessValueSections locale={locale} variant="home" />
    </>
  ) : routeKey === "process" ? (
    <ProcessMethod locale={locale} />
  ) : (
    <PageHero
      eyebrow={content.eyebrow}
      title={content.heading}
      text={content.intro}
      variant={routeKey === "services" ? "services" : "default"}
      serviceMap={content.serviceMap}
    />
  )}

  {routesWithStandardCards.includes(routeKey) ? (
    <>
      {content.cards && <CardGrid cards={content.cards} />}
      {routeKey === "services" && <BusinessValueSections locale={locale} variant="services" />}
    </>
  ) : null}

  {routeKey === "projects" ? (
    <section class="section">
      <div class="container projectGrid">
        {projects[locale].map((project) => <ProjectCard project={project} labels={labels} />)}
      </div>
    </section>
  ) : null}

  {projectStructuredData ? (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(projectStructuredData)}
    ></script>
  ) : null}

  {routeKey === "skills" ? (
    <section class="section">
      <div class="container skillMatrix">
        {skillGroups[locale].map((skill) => (
          <SkillCard skill={skill} labels={labels} locale={locale} />
        ))}
      </div>
    </section>
  ) : null}

  {skillStructuredData ? (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(skillStructuredData)}
    ></script>
  ) : null}

  {routeKey === "contact" ? (
    <section class="section">
      <div class="container">
        <ContactForm locale={locale} />
      </div>
    </section>
  ) : null}
</BaseLayout>