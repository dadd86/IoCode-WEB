---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeHero from "../../components/HomeHero.astro";
import PageHero from "../../components/PageHero.astro";
import CardGrid from "../../components/CardGrid.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SkillCard from "../../components/SkillCard.astro";
import PageControl from "../../components/PageControl.astro";
import ContactForm from "../../components/ContactForm.astro";
import BusinessValueSections from "../../components/BusinessValueSections.astro";
import ProcessMethod from "../../components/ProcessMethod.astro";
import LegalPage from "../../components/LegalPage.astro";
import { pageContent } from "../../data/pageContent";
import { portfolioPageCopy, projects } from "../../data/projects";
import { skillGroups, skillsPageCopy } from "../../data/skills";
import { ui } from "../../i18n/ui";
import { getLocalizedPath, getStaticRouteParams } from "../../i18n/routes";
import type { Locale } from "../../i18n/config";
import type { RouteKey } from "../../i18n/routes";
import { siteConfig } from "../../data/site";
import { legalProfileProductionReady } from "../../config/legal";

export function getStaticPaths() {
  return getStaticRouteParams();
}

const { locale, routeKey } = Astro.props as { locale: Locale; routeKey: RouteKey };
const content = pageContent[locale][routeKey];
const labels = ui[locale];
const languageTag: Record<Locale, string> = {
  es: "es-ES",
  en: "en-US",
  de: "de-DE"
};

const routesWithStandardCards: RouteKey[] = ["services", "plc", "robotics", "about"];
const isLegalRoute = routeKey === "imprint" || routeKey === "privacy";
const pageRobots = isLegalRoute && !legalProfileProductionReady
  ? "noindex, nofollow, noarchive"
  : undefined;

const projectStructuredData =
  routeKey === "projects"
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "@id": `${siteConfig.url}${getLocalizedPath("projects", locale)}#projects`,
        name: content.heading,
        description: content.description,
        itemListElement: projects[locale].map((project, index) => ({
          "@type": "ListItem",
          position: index + 1,
          item: {
            "@type": project.schemaType,
            "@id": `${siteConfig.url}${project.path}#software`,
            name: project.title,
            description: project.summary,
            inLanguage: languageTag[locale],
            codeRepository: project.publicLinks[0]?.href,
            programmingLanguage: project.technologies,
            keywords: project.keywords,
            about: project.capabilities,
            url: `${siteConfig.url}${project.path}`
          }
        }))
      }
    : null;

const skillStructuredData =
  routeKey === "skills"
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "@id": `${siteConfig.url}${getLocalizedPath("skills", locale)}#technical-skills`,
        name: content.heading,
        description: content.description,
        inLanguage: languageTag[locale],
        numberOfItems: skillGroups[locale].length,
        itemListElement: skillGroups[locale].map((skill, index) => ({
          "@type": "ListItem",
          position: index + 1,
          item: {
            "@type": "DefinedTerm",
            "@id": `${siteConfig.url}${getLocalizedPath("skills", locale)}#${skill.slug}`,
            name: skill.title,
            description: skill.businessProblem,
            termCode: skill.slug,
            inDefinedTermSet: `${siteConfig.url}${getLocalizedPath("skills", locale)}#technical-skills`
          }
        }))
      }
    : null;
---

<BaseLayout
  locale={locale}
  routeKey={routeKey}
  title={content.title}
  description={content.description}
  robots={pageRobots}
  socialImageAlt={
    routeKey === "projects"
      ? portfolioPageCopy[locale].imageAlt
      : routeKey === "skills"
        ? skillsPageCopy[locale].imageAlt
        : undefined
  }
>
  {routeKey === "home" ? (
    <>
      <HomeHero locale={locale} content={content} />

      {content.cards && <CardGrid cards={content.cards} />}

      <BusinessValueSections locale={locale} variant="home" />
    </>
  ) : routeKey === "process" ? (
    <ProcessMethod locale={locale} />
  ) : (
    <PageHero
      eyebrow={content.eyebrow}
      title={content.heading}
      text={content.intro}
      variant={routeKey === "services" ? "services" : "default"}
      serviceMap={content.serviceMap}
    />
  )}

  {routesWithStandardCards.includes(routeKey) ? (
    <>
      {content.cards && <CardGrid cards={content.cards} />}
      {routeKey === "services" && <BusinessValueSections locale={locale} variant="services" />}
    </>
  ) : null}

  {routeKey === "projects" ? (
    <section class="section">
      <div class="container">
        <PageControl
          locale={locale}
          kind="projects"
          items={projects[locale].map(({ slug, title }) => ({ id: slug, label: title }))}
        >
          {projects[locale].map((project, index) => (
            <ProjectCard
              project={project}
              labels={labels}
              tabId={`projects-page-tab-${project.slug}`}
              active={index === 0}
              detailHref={project.path}
            />
          ))}
        </PageControl>
      </div>
    </section>
  ) : null}

  {projectStructuredData ? (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(projectStructuredData)}
    ></script>
  ) : null}

  {routeKey === "skills" ? (
    <section class="section">
      <div class="container">
        <PageControl
          locale={locale}
          kind="skills"
          items={skillGroups[locale].map(({ slug, title }) => ({ id: slug, label: title }))}
        >
          {skillGroups[locale].map((skill, index) => (
            <SkillCard
              skill={skill}
              labels={labels}
              locale={locale}
              tabId={`skills-page-tab-${skill.slug}`}
              active={index === 0}
            />
          ))}
        </PageControl>
      </div>
    </section>
  ) : null}

  {skillStructuredData ? (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(skillStructuredData)}
    ></script>
  ) : null}

  {routeKey === "contact" ? (
    <section class="section">
      <div class="container">
        <ContactForm locale={locale} />
      </div>
    </section>
  ) : null}

  {isLegalRoute ? <LegalPage locale={locale} kind={routeKey as "imprint" | "privacy"} /> : null}
</BaseLayout>
